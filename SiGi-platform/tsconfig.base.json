{
  "compilerOptions": {
    "target": "ES2020",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@sigi/contracts": ["libs/contracts/src/index.ts"],
      "@sigi/domain": ["libs/domain/src/index.ts"],
      "@sigi/shared": ["libs/shared/src/index.ts"],
      "@sigi/ui": ["libs/ui/src/index.tsx"]
    }
  }
}

