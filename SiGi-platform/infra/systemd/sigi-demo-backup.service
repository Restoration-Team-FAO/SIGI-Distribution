[Unit]
Description=SIGI controlled demo backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=sigi
Group=sigi
WorkingDirectory=/opt/sigi
EnvironmentFile=/etc/sigi/backup.env
ExecStart=/usr/bin/node /opt/sigi/scripts/ops/backup-platform.mjs
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077

[Install]
WantedBy=multi-user.target
